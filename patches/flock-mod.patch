-        let nnz_per_mat = 3 * k; // ~6K nonzeros per matrix
-        let a_0 = random_sparse_matrix(k, nnz_per_mat, &mut rng);
-        let b_0 = random_sparse_matrix(k, nnz_per_mat, &mut rng);
