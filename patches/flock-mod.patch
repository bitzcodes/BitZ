-                "  fold A/B: iblock {:>9.2} ms   default {:>9.2} ms   Δ {:+8.2} ms  (default {:.3}× faster)",
-                ib_min,
-                def_min,
-                ib_min - def_min,
-                ib_min / def_min,
-            );
-            println!("  checksum: {cs:016x}");
