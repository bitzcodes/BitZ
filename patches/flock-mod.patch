-    let m = setup.m();
-    let mut rng = Rng(0x5A2 ^ n as u64);
-    let comps: Vec<Compression> = (0..n)
-        .map(|_| {
-            (
-                std::array::from_fn(|_| rng.u32()),
-                std::array::from_fn(|_| rng.u32()),
-            )
-        })
-        .collect();
-
-    println!("\n=== sha2, {n} compressions (m = {m}) ===");
