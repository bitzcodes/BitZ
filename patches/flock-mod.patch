-//! GF(2^8) with the AES irreducible polynomial x^8 + x^4 + x^3 + x + 1.
-//!
-//! Reduction: x^8 ≡ x^4 + x^3 + x + 1, so the upper byte h folds back as
-//!   h ^ (h<<1) ^ (h<<3) ^ (h<<4).
