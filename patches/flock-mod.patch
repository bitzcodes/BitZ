-        *byte = rng.next_u64() as u8;
-    }
-
-    // Warm-up.
-    let _ = merkle::merkle_tree(&data, n_leaves, kind);
-
-    let t0 = Instant::now();
-    let mut times = Vec::with_capacity(n_runs);
-    for _ in 0..n_runs {
