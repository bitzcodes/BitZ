-/// Software fallback / test oracle. Used when `aes` is off, and as the
-/// cross-check oracle inside the `software_matches_neon` unit test.
-#[allow(dead_code)]
-#[inline]
-const fn clmul8_software(a: u8, b: u8) -> u16 {
-    let b16 = b as u16;
-    let mut acc: u16 = 0;
-    let mut i = 0;
-    while i < 8 {
-        if (a >> i) & 1 != 0 {
-            acc ^= b16 << i;
-        }
-        i += 1;
-    }
-    acc
-}
