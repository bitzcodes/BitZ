-    // typical CHUNK_START|CHUNK_END|ROOT for a single-block chunk.
-    (cv, m, rng.next_u32() as u64, 64u32, 11u32)
-}
-
-fn fmt_ms(s: f64) -> String {
-    let ms = s * 1000.0;
-    if ms < 1.0 {
-        format!("{:>8.2} µs", s * 1e6)
-    } else if ms < 1000.0 {
-        format!("{:>8.2} ms", ms)
-    } else {
-        format!("{:>8.2} s ", s)
-    }
-}
-
-fn bench_one(n_blocks: usize, n_runs: usize) {
