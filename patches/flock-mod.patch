-    let total_muls: u64 = (1u64 << k) * (k as u64) / 2;
-    let ns_per_mul = if total_muls == 0 {
-        0.0
-    } else {
-        secs * 1e9 / total_muls as f64
-    };
-    println!(
-        "  {:<46}  {:>7.4} s  {:>6.2} GB/s  {:>6.2} ns/mul  [cs={:016x}]",
