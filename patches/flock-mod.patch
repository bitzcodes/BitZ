-#[cfg(all(target_arch = "aarch64", target_feature = "aes"))]
-#[target_feature(enable = "aes")]
-#[inline]
-unsafe fn clmul8_neon(a: u8, b: u8) -> u16 {
-    use core::arch::aarch64::*;
-    let va = vdup_n_p8(a);
-    let vb = vdup_n_p8(b);
-    let prod = vmull_p8(va, vb);
-    vgetq_lane_u16::<0>(vreinterpretq_u16_p16(prod))
