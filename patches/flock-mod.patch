-        // Pre-generate n_runs + 1 distinct (witness, claim point) sets so each
-        // run hits a fresh FS transcript. The first is the warm-up; the rest
-        // are timed.
-        let mut witnesses: Vec<(Vec<u8>, QuirkyPoint)> = Vec::with_capacity(n_runs + 1);
