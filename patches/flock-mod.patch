-    int x = threadIdx.x;
-    s1[x] = a1; sinf[x] = ainf;
-    __syncthreads();
-    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
-        if (x < s) { s1[x] = f128_add(s1[x], s1[x + s]); sinf[x] = f128_add(sinf[x], sinf[x + s]); }
-        __syncthreads();
-    }
-    if (x == 0) { *e1_out = s1[0]; *einf_out = sinf[0]; }
-}
