-        }
-
-        let mut best_ms = f64::INFINITY;
-        let mut cs = 0u64;
-        for run in 0..n_runs {
-            let label = if n_runs == 1 {
-                String::from("lincheck::prove")
-            } else {
-                format!("lincheck::prove (run {})", run + 1)
-            };
-            let (z_packed, x_ab) = &witnesses[run + 1];
