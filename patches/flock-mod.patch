-    // "Useful work" rate: nnz bit-ops per block × blocks.
-    let ops = (nnz as f64) * (n_outer as f64);
-    println!(
-        "{name}: m={m} (k=2^{k_log}, {n_outer} blocks, {nnz} nnz)\n  \
-         old {:>9.2} ms ({:>6.2} Gop/s)   new {:>9.2} ms ({:>6.2} Gop/s)   speedup {:>5.2}x",
-        t_old * 1e3,
-        ops / t_old / 1e9,
-        t_new * 1e3,
-        ops / t_new / 1e9,
-        t_old / t_new,
-    );
-}
-
-fn main() {
