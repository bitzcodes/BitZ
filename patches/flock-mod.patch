-struct Rng(u64);
-impl Rng {
-    fn new(seed: u64) -> Self {
-        Self(seed)
-    }
-    fn nx(&mut self) -> u64 {
-        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
-        let mut z = self.0;
-        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
-        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
-        z ^ (z >> 31)
-    }
-}
-
-fn fmt_ms(s: f64) -> String {
-    let ms = s * 1000.0;
-    if ms < 1.0 {
-        format!("{:>8.2} µs", s * 1e6)
-    } else if ms < 1000.0 {
-        format!("{:>8.2} ms", ms)
-    } else {
-        format!("{:>8.2} s ", s)
-    }
-}
