-        F128 first = PHI_8_TABLE[off];
-        for (int j = 1; j < ell; j++)
-            denominator = MUL(denominator, ADD(first, PHI_8_TABLE[off + j]));
-        found = denominator_inverses.emplace(domain, f128_inv_host(denominator)).first;
-    }
