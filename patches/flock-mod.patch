-	set +e
-	( cd "$BHS_DIR" && RAYON_NUM_THREADS="$THREADS" PCS_LOG_INV_RATE="${PCS_LOG_INV_RATE:-1}" bash bench.sh "$pkg" keccak "$lp" )
