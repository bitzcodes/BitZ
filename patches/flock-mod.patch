-	if [[ -z "$ks" ]]; then
-		return   # everything cached or over budget; cached rows already appended
-	fi
-	cooldown "flock 2^${specs[0]%%:*}"
-	echo
-	echo "############### flock — keccak3_proof (K=[$ks]) ###############"
-	log="$(mktemp)"
-	set +e
-	( cd "$FLOCK_ROOT" && KECCAK3_KS="$ks" cargo bench --bench keccak3_proof ) 2>&1 | tee "$log"
-	status="${PIPESTATUS[0]}"
