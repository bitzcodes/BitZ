-                lo: vgetq_lane_u64::<0>(final_lo),
-                hi: vgetq_lane_u64::<0>(final_hi),
-            },
-            F128 {
-                lo: vgetq_lane_u64::<1>(final_lo),
-                hi: vgetq_lane_u64::<1>(final_hi),
-            },
-        ]
-    }
-}
