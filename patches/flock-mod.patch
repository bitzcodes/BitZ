-            F128 af1 = f128_add(a2, ghash_mul_karatsuba(rho, f128_add(a2, a3)));
-            F128 bf0 = f128_add(b0, ghash_mul_karatsuba(rho, f128_add(b0, b1)));
-            F128 bf1 = f128_add(b2, ghash_mul_karatsuba(rho, f128_add(b2, b3)));
