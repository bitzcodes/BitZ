-    int idx = pos >> 6, s = pos & 63;
-    rec[idx] |= (b3u64)val << s;
-    if (s > 32) rec[idx + 1] |= (b3u64)val >> (64 - s);
-}
-__device__ __forceinline__ void b3_rec_flush(const b3u64 rec[4], b3u64* buf, int base) {
