+    assert!(IntEvalParams::derive_with_target(2048, 64, 9, 13, 129).is_err());
+    let mut p = IntEvalParams::derive_with_target(2048, 64, 9, 13, 112).unwrap();
+    p.format_version = 1;
+    assert!(p.validate(13).is_err());
+  }
