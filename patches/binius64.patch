+			assert!(message_len(i).is_err());
+		}
+		let bytes = std::array::from_fn(|i| i as u8);
+		assert_eq!(
+			limbs(&bytes),
+			[
+				0x18191a1b1c1d1e1f,
+				0x1011121314151617,
+				0x08090a0b0c0d0e0f,
+				0x0001020304050607
+			]
+		);
+		assert_eq!(public_words(3, &bytes, &bytes, &bytes, &bytes).len(), 17);
+	}
+}
